SECRET_KEY=

# Microsoft Graph API (preferred delivery method for enrollment mail)
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
MSGRAPH_USER_ID=

# SMTP (fallback delivery method - used automatically if Graph API delivery
# fails, or if the Graph API settings above are left blank)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

DEFAULT_FROM_EMAIL=
